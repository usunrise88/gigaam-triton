name: "{{ name }}"
platform: "ensemble"
max_batch_size: {{ max_batch_size }}

# Same input contract as the CTC ensembles: audio FP32 + audio_len INT32, so
# the provider does not have to know which head is behind the name (spec §7.2).
input [
  {
    name: "audio"
    data_type: TYPE_FP32
    dims: [ -1 ]
  },
  {
    name: "audio_len"
    data_type: TYPE_INT32
    dims: [ 1 ]
  }
]

output [
  {
    name: "text"
    data_type: TYPE_STRING
    dims: [ 1 ]
  },
  {
    name: "tokens"
    data_type: TYPE_INT32
    dims: [ -1 ]
  },
  {
    name: "token_scores"
    data_type: TYPE_FP32
    dims: [ -1 ]
  },
  {
    name: "tokens_len"
    data_type: TYPE_INT32
    dims: [ 1 ]
  },
  {
    name: "decode_steps"
    data_type: TYPE_INT32
    dims: [ 1 ]
  },
  {
    name: "loop_ms"
    data_type: TYPE_FP32
    dims: [ 1 ]
  },
  {
    name: "upload_ms"
    data_type: TYPE_FP32
    dims: [ 1 ]
  }
]

ensemble_scheduling {
  step [
    {
      model_name: "{{ preprocessing_model }}"
      model_version: -1
      input_map { key: "audio"     value: "audio" }
      input_map { key: "audio_len" value: "audio_len" }
      output_map { key: "features"        value: "features" }
      output_map { key: "feature_lengths" value: "feature_lengths" }
    },
    {
      model_name: "{{ encoder_model }}"
      model_version: -1
      input_map { key: "audio_signal" value: "features" }
      input_map { key: "length"       value: "feature_lengths" }
      output_map { key: "encoded"     value: "encoded" }
      output_map { key: "encoded_len" value: "encoded_len" }
    },
    {
      model_name: "{{ decoder_model }}"
      model_version: -1
      input_map { key: "encoded"         value: "encoded" }
      input_map { key: "encoded_lengths" value: "encoded_len" }
      output_map { key: "text"          value: "text" }
      output_map { key: "tokens"        value: "tokens" }
      output_map { key: "token_scores"  value: "token_scores" }
      output_map { key: "tokens_len"    value: "tokens_len" }
      output_map { key: "decode_steps"  value: "decode_steps" }
      output_map { key: "loop_ms"       value: "loop_ms" }
      output_map { key: "upload_ms"     value: "upload_ms" }
    }
  ]
}
